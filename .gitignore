# file is kept locally only as a format reference.
*.pdf
*.recovered.txt
nr_prach.c

# ---- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---- logs and scratch -----------------------------------------------------
*.log
*.tmp

# ---- OS -------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
